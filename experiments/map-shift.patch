index b8feb07..38452e0 100644
--- a/snes/native_runtime.asm
+++ b/snes/native_runtime.asm
@@ -776,6 +776,22 @@ bulk_ring_bytes:
     ldy #0
     rts
 
+; Original C3B9 performs five signed right shifts of $26/$27. CMP supplies
+; the sign carry for ROR without rebuilding the high byte using AND/ORA.
+map_shift_loop:
+    jsr map_shift_five
+    jmp $C3CA
+map_shift_five:
+    .repeat 5
+        lda $27
+        cmp #$80
+        ror $27
+        ror $26
+    .endrepeat
+    lda $27
+    ldx #0               ; original final DEX sets Z and clears N
+    rts
+
 bank_switch_enter:
     ; Direct translation of FED1's paired-bank operation. The original routine
     ; uses four generic mapper writes, but their effect is fully determined by
