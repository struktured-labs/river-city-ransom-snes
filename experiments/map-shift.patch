+    cpy $1C8A
+    jne failed
+    lda $26
+    cmp $B000,y
+    jne failed
+    lda $27
+    cmp $B001,y
+    jne failed
+    iny
+    iny
+    iny
+    cpy #125
+    bne @vector
+    lda $1C8F
+    bne @done
+    lda #$40
+    sta $1C8F
