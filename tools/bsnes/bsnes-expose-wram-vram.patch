 // Currently, there is no safe/sensible way to use the memory interface without severe hackery.
 // Rely on higan to load and save SRAM until there is really compelling reason not to.
+namespace SuperFamicom { void* rcrWram(); void* rcrVram(); }
+// rcr-work: expose WRAM (2) and accurate-PPU VRAM (0x100) for read-only checking.
 RETRO_API void *retro_get_memory_data(unsigned id)
 {
+	if(id == RETRO_MEMORY_SYSTEM_RAM) return SuperFamicom::rcrWram();
+	if(id == 0x100) return SuperFamicom::rcrVram();
 	return nullptr;
 }
 
 RETRO_API size_t retro_get_memory_size(unsigned id)
 {
+	if(id == RETRO_MEMORY_SYSTEM_RAM) return 128 * 1024;
+	if(id == 0x100) return 64 * 1024;
 	return 0;
 }
