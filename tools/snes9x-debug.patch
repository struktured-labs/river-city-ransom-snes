+            Registers.PCw == 0xf168 || Registers.PCw == 0xf103 || Registers.PCw == 0xf12b ||
+            Registers.PCw == 0xfc60 || Registers.PCw == 0xff76 || Registers.PCw == 0xf223 ||
+            Registers.PCw == 0xfed1 || Registers.PCw == 0xfa54 || Registers.PCw == 0xfa5f ||
