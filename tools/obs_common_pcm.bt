    $speakers=*(uint32 *)(arg1+68);
    $format=*(uint32 *)(arg1+72);
    $rate=*(uint32 *)(arg1+76);
    @source[arg0]=1; @seq[arg0]++;
    if ($frames>0 && $frames<=1024 && $speakers==2 && $rate==48000 && ($format==2 || $format==3)) {
