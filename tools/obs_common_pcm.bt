// Read only DeckLink's submitted PCM and its source-capture callback PCM.
// No settings or process-memory writes. Exact hash-bound OBS binaries required.
config = { max_strlen = 8192; }
BEGIN { printf("B,%llu\n",nsecs); }
uprobe:/usr/local/lib/obs-plugins/decklink.so:_ZN22DeckLinkDeviceInstance17HandleAudioPacketEP25IDeckLinkAudioInputPacketm
/pid == $1/ { @deck[tid]=1; }
